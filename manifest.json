{
  "manifest_version": 3,
  "name": "Tab Merger",
  "version": "1.0.0",
  "description": "Merge all windows and tabs from each Chrome profile into a single window",
  "permissions": [
    "tabs",
    "windows",
    "tabGroups"
  ],
  "action": {
    "default_title": "Merge All Tabs"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
